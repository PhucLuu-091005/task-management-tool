# Django
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=core.settings.development

# Database
DB_NAME=taskmanagement
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend base URL — used to build task deep links in notification emails
FRONTEND_URL=http://localhost:3000

# Email — defaults to the console backend in dev; set SMTP values for real delivery
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@taskmanagement.local

# S3 attachment storage — only used by core.settings.production (dev stays on local disk).
# Credentials come from the standard AWS env vars below or an attached IAM role.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=            # optional; set for S3-compatible providers (MinIO, etc.)
# AWS_PRESIGNED_EXPIRY=3600       # signed-URL lifetime in seconds
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
